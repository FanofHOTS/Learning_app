# URL backend mà frontend dùng để gọi API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# URL frontend dùng cho liên kết và callback.
NEXT_URL=http://localhost:3000
# Bật dữ liệu mô phỏng khi true; production nên đặt false.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Cho phép người dùng đăng ký tài khoản mới.
REGISTER_ALLOWED=true
# Yêu cầu xác minh email sau khi đăng ký.
EMAIL_VERIFICATION_REQUIRED=false
# Thời gian hết hạn token xác minh email, tính bằng giờ.
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Bật truyền tải package Hugging Face nhanh hơn.
HF_HUB_ENABLE_HF_TRANSFER=1
# Bật truyền tải nhanh cho request suy luận Hugging Face.
HF_HUB_ENABLE_HF_TRANSFER_INFERENCE=1
# Môi trường chạy ứng dụng, ví dụ development hoặc production.
NODE_ENV=development

# Token dùng để gọi API Hugging Face.
HF_TOKEN=
# Tên model Hugging Face xử lý văn bản và tạo câu hỏi.
HF_TEXT_QUESTION_MODEL=Qwen/Qwen2.5-7B-Instruct:preferred
# Tên model Hugging Face xử lý ảnh, PDF hoặc video.
HF_VISION_QUESTION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:hyperbolic
# Số câu hỏi tối đa frontend cho phép tạo trong một lần.
NEXT_PUBLIC_AI_GENERATOR_MAX_QUESTIONS=20
# Số câu hỏi tối đa backend cho phép tạo trong một lần.
AI_GENERATOR_MAX_QUESTIONS=20

# Kích thước tối đa của cạnh dài ảnh gửi cho model thị giác.
HF_VISUAL_IMAGE_MAX_DIM=1024
# Chất lượng JPEG khi nén ảnh gửi cho model thị giác, từ 50 đến 95.
HF_VISUAL_IMAGE_JPEG_QUALITY=80
# Tự động cắt lề trắng trước khi mã hóa ảnh.
HF_VISUAL_TRIM_MARGINS=true
# Bỏ qua trang trắng hoặc trang bìa khi xử lý PDF.
HF_VISUAL_SKIP_BLANK_PAGES=true
# Loại bỏ các khung hình video gần giống nhau.
HF_VISUAL_DEDUPE_FRAMES=true
# Tự động chỉnh độ nghiêng của ảnh trước khi xử lý.
HF_VISUAL_DESKEW=true

# Tự động cắt lề trắng trước khi OCR.
RAPIDOCR_TRIM_MARGINS=true
# Kích thước tối đa của cạnh dài ảnh trước khi OCR, từ 256 đến 10000.
RAPIDOCR_MAX_SIDE=4096
# Tự động chỉnh độ nghiêng ảnh trước khi OCR.
RAPIDOCR_DESKEW=true
# Bật tiền xử lý nâng cao cho pipeline RapidOCR.
RAPIDOCR_ENHANCED_PREPROCESSING=true

# Biến DATABASE tương thích cũ, thường có thể để trống.
DATABASE=
# URL kết nối cơ sở dữ liệu đầy đủ.
DATABASE_URL=
# Tên cơ sở dữ liệu PostgreSQL.
DATABASE_NAME=
# Tên người dùng PostgreSQL.
DATABASE_USER=
# Mật khẩu PostgreSQL.
DATABASE_PASSWORD=
# Địa chỉ máy chủ PostgreSQL.
DATABASE_HOST=
# Cổng kết nối PostgreSQL.
DATABASE_PORT=
# Chế độ SSL của kết nối database.
DATABASE_SSLMODE=disable

# Backend lưu trữ tài liệu: auto, local hoặc blob.
DOCUMENT_STORAGE_BACKEND=auto
# Token ghi dữ liệu vào Vercel Blob.
BLOB_READ_WRITE_TOKEN=
# Thư mục lưu file local hoặc đường dẫn upload.
UPLOAD_DIR=public/uploads
# Tiền tố key cho file lưu trên Blob.
BLOB_KEY_PREFIX=documents
# Quyền truy cập mặc định của file Blob.
BLOB_ACCESS=public

# Địa chỉ email dùng làm nguồn gửi chung.
MAIL_FROM=
# Địa chỉ email hiển thị là người gửi.
MAIL_FROM_EMAIL=
# API key của Resend nếu dùng Resend gửi email.
RESEND_API_KEY=
# Máy chủ SMTP.
SMTP_HOST=
# Cổng SMTP.
SMTP_PORT=
# Tên đăng nhập SMTP.
SMTP_USERNAME=
# Mật khẩu SMTP.
SMTP_PASSWORD=
# Địa chỉ email gửi qua SMTP.
SMTP_FROM_EMAIL=
# Tên hiển thị của người gửi email.
MAIL_FROM_NAME=Hệ thống học tập trực tuyến
# Bật mã hóa TLS cho kết nối SMTP.
SMTP_USE_TLS=true
# Bật SSL/TLS trực tiếp khi kết nối SMTP.
MAIL_SSL_TLS=false
# Có sử dụng thông tin đăng nhập SMTP hay không.
MAIL_USE_CREDENTIALS=true
# Có kiểm tra chứng chỉ TLS của máy chủ email hay không.
MAIL_VALIDATE_CERTS=true

# Khóa bí mật dùng để ký access token JWT.
SECRET_KEY=
# Thuật toán ký JWT.
ALGORITHM=HS256
# Thời gian access token có hiệu lực, tính bằng phút.
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Thời gian mã khôi phục mật khẩu có hiệu lực, tính bằng phút.
PASSWORD_RECOVERY_CODE_EXPIRE_MINUTES=5
