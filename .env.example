NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK_DATA=false

REGISTER_ALLOWED=true

HF_HUB_ENABLE_HF_TRANSFER=1
HF_HUB_ENABLE_HF_TRANSFER_INFERENCE=1
NODE_ENV=development

HF_TOKEN=
HF_TEXT_QUESTION_MODEL=Qwen/Qwen2.5-7B-Instruct:preferred
HF_VISION_QUESTION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:hyperbolic
NEXT_PUBLIC_AI_GENERATOR_MAX_QUESTIONS=20
AI_GENERATOR_MAX_QUESTIONS=20

# Tối ưu token khi gửi ảnh cho vision model
# - HF_VISUAL_IMAGE_MAX_DIM: giới hạn cạnh dài nhất của ảnh (mặc định 1024px)
# - HF_VISUAL_IMAGE_JPEG_QUALITY: chất lượng nén JPEG (50-95)
# - HF_VISUAL_TRIM_MARGINS: tự cắt lề trắng trước khi mã hóa
# - HF_VISUAL_SKIP_BLANK_PAGES: bỏ trang trắng/bìa khi render PDF
# - HF_VISUAL_DEDUPE_FRAMES: loại khung hình video gần giống nhau (slide tĩnh)
# - HF_VISUAL_DESKEW: tự chỉnh nghiêng ảnh trước khi mã hóa
HF_VISUAL_IMAGE_MAX_DIM=1024
HF_VISUAL_IMAGE_JPEG_QUALITY=80
HF_VISUAL_TRIM_MARGINS=true
HF_VISUAL_SKIP_BLANK_PAGES=true
HF_VISUAL_DEDUPE_FRAMES=true
HF_VISUAL_DESKEW=true

# Tối ưu pipeline OCR local RapidOCR
# - RAPIDOCR_TRIM_MARGINS: tự cắt lề trắng trước khi OCR (tăng độ chính xác)
# - RAPIDOCR_MAX_SIDE: giới hạn cạnh dài nhất của ảnh trước khi OCR (256-10000)
# - RAPIDOCR_DESKEW: tự phát hiện và xoay ảnh bị nghiêng về ngang (tăng độ chính xác)
# - RAPIDOCR_ENHANCED_PREPROCESSING: pipeline nâng cao (mặc định 1)
RAPIDOCR_TRIM_MARGINS=true
RAPIDOCR_MAX_SIDE=4096
RAPIDOCR_DESKEW=true

DATABASE=
DATABASE_URL=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_SSLMODE=disable

DOCUMENT_STORAGE_BACKEND=auto
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=public/uploads
BLOB_KEY_PREFIX=documents
BLOB_ACCESS=public

MAIL_FROM=
MAIL_FROM_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
MAIL_FROM_NAME=Hệ thống học tập trực tuyến
SMTP_USE_TLS=true
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RECOVERY_CODE_EXPIRE_MINUTES=5